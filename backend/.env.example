DATABASE_URL=dev.db

# Optional: path to ICE server config JSON.
# Relative paths are resolved from the backend process cwd, absolute paths are used as-is.
# Examples: ice.json, ./ice/ice.json, /etc/trurpchat/ice.json
# Falls back to backend/ice.json when unset.
ICE_CONFIG_FILE=ice.json

# TODO: remove in future versions. Legacy OvenMediaEngine URL kept for backwards compatibility.
OVEN_SERVER_URL=localhost:3333

# OvenMediaEngine connection settings
OVEN_HOST=localhost
OVEN_WATCH_PORT=3333
OVEN_STREAM_PORT=1935
OVEN_APP_NAME=app
OVEN_SECURE=false
